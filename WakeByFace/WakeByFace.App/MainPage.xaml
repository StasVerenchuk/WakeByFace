                                </Frame>
                            </Grid>
                        </Grid>
                    </Frame>
                    <!--#endregion-->

                    <!-- Далі можна додати ще статичні/тестові будильники у сірому стилі -->
                </VerticalStackLayout>
            </ScrollView>
        </Frame>

        <Frame Grid.Row="2"
               BorderColor="Transparent"
               BackgroundColor="Transparent"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               Padding="0">
            <ImageButton x:Name="btnCreate"
                         Source="add.png"
                         VerticalOptions="Center"
                         HorizontalOptions="Center"
                         HeightRequest="50"
                         WidthRequest="50"
                         BackgroundColor="Transparent"
                         Clicked="CreateAlarmButtonClicked"/>
        </Frame>
        
    </Grid>

</ContentPage>
