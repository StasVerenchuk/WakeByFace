<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WakeByFace.App.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#7B9B9C">
    <ContentPage.Resources>
        <Color x:Key="MainBackgroundColor">#7B9B9C</Color>
        <Color x:Key="SectionsColor">#a6b0b1</Color>
        <Color x:Key="OrangeColor">#e69a67</Color>
        <Color x:Key="DarkColor">#383e3f</Color>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".15*"/>
            <RowDefinition Height=".75*"/>
            <RowDefinition Height=".1*"/>
        </Grid.RowDefinitions>

        <Frame BackgroundColor="{StaticResource MainBackgroundColor}"
               BorderColor="Transparent"
               HasShadow="False"
               CornerRadius="0"
               Padding="0" >
            <Grid BackgroundColor="{StaticResource MainBackgroundColor}">

                <Image Source="alarms.png"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

                <!--Роздільна Вертикальна лінія-->
                <BoxView HeightRequest="2"
                         HorizontalOptions="FillAndExpand"
                         VerticalOptions="End"
                         BackgroundColor="{StaticResource DarkColor}"/>
            </Grid>
        </Frame >

        <Frame Grid.Row="1"
       BackgroundColor="{StaticResource MainBackgroundColor}"
       BorderColor="Transparent"
       HasShadow="False"
       CornerRadius="0"
       Padding="0">

            <ScrollView>
                <CollectionView x:Name="AlarmsCollectionView"
                        ItemsSource="{Binding Alarms}"
                        SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="20"
                           HasShadow="False"
                           Padding="12"
                           Margin="10"
                           BackgroundColor="{StaticResource SectionsColor}">

                                <!-- Динамічний фон: активний/неактивний -->
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame"
                                         Binding="{Binding IsEnabled}"
                                         Value="True">
                                        <Setter Property="BackgroundColor"
                                        Value="{StaticResource OrangeColor}" />
                                    </DataTrigger>

                                    <DataTrigger TargetType="Frame"
                                         Binding="{Binding IsEnabled}"
                                         Value="False">
                                        <Setter Property="BackgroundColor"
                                        Value="{StaticResource SectionsColor}" />
                                    </DataTrigger>
                                </Frame.Triggers>

                                <!-- Вміст картки будильника -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Ліва частина -->
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">

                                        <!-- Назва будильника -->
                                        <Label Text="{Binding Name}"
                                       FontSize="14"
                                       TextColor="{StaticResource DarkColor}" />

                                        <!-- Час -->
                                        <Label Text="{Binding TimeFormatted}"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource DarkColor}" />

                                        <!-- Дні (динамічно) -->
                                        <Label Text="{Binding RepeatDaysDisplay}"
                                       FontSize="12"
                                       TextColor="{StaticResource DarkColor}" />
                                    </VerticalStackLayout>

                                    <!-- Тумблер -->
                                    <Switch Grid.Column="1"
                                    IsToggled="{Binding IsEnabled}"
                                    Toggled="AlarmEnabledToggled"
                                    VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </ScrollView>
        </Frame>

        <Frame Grid.Row="2"
               BorderColor="Transparent"
               BackgroundColor="Transparent"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               Padding="0">
            <VerticalStackLayout>
                <ImageButton x:Name="btnCreate"
                             Source="add.png"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             HeightRequest="50"
                             WidthRequest="50"
                             BackgroundColor="Transparent"
                             Clicked="CreateAlarmButtonClicked"/>
                <Button x:Name="btnStartTestAlarm"
                        Clicked="StartTestAlarmButtonClicked"
                        Text="Запустити тест будильника"
                        BackgroundColor="{StaticResource OrangeColor}"
                        TextColor="{StaticResource DarkColor}"
                        CornerRadius="16"
                        HeightRequest="40"
                        HorizontalOptions="Center"
                        Margin="0,10"/>
            </VerticalStackLayout>
        </Frame>
        
    </Grid>

</ContentPage>
