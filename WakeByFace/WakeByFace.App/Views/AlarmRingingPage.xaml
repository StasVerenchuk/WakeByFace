<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WakeByFace.App.Views.AlarmRingingPage"
             Title="AlarmRingingPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#7b9b9c">
    <ContentPage.Resources>
        <Color x:Key="MainBackgroundColor">#7B9B9C</Color>
        <Color x:Key="SectionsColor">#a6b0b1</Color>
        <Color x:Key="OrangeColor">#e69a67</Color>
        <Color x:Key="DarkColor">#383e3f</Color>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".2*" />
            <RowDefinition Height=".6*" />
            <RowDefinition Height=".2*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Frame Grid.Row="0"
               BackgroundColor="{StaticResource SectionsColor}"
               Padding="0"
               HasShadow="False">
            <Grid BackgroundColor="{StaticResource MainBackgroundColor}">
                <Label Text="Будильник"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OrangeColor}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Grid>
        </Frame>

        <!-- Main -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="20"
                             Spacing="16"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

            <Label Text="{Binding Name}"
                   FontSize="20"
                   TextColor="{StaticResource DarkColor}"
                   HorizontalTextAlignment="Center"/>

            <Label Text="{Binding TextFormatted}"
                   FontSize="52"
                   FontAttributes="Bold"
                   TextColor="{StaticResource DarkColor}"
                   HorizontalTextAlignment="Center"/>

            <Frame BackgroundColor="{StaticResource SectionsColor}"
                   CornerRadius="18"
                   Padding="16"
                   WidthRequest="320">

                <VerticalStackLayout Spacing="8">

                    <Label x:Name="targetEmotionLabel"
                           FontSize="18"
                           TextColor="{StaticResource DarkColor}"
                           HorizontalTextAlignment="Center"/>

                    <Label x:Name="statusLabel"
                           FontSize="14"
                           TextColor="{StaticResource DarkColor}"
                           HorizontalTextAlignment="Center"/>

                    <Label x:Name="resultLabel"
                           FontSize="14"
                           TextColor="{StaticResource DarkColor}"
                           HorizontalTextAlignment="Center"/>

                    <Button Text="Зробити фото"
                            Clicked="CaptureButtonClicked"
                            BackgroundColor="{StaticResource OrangeColor}"
                            TextColor="{StaticResource DarkColor}"
                            CornerRadius="30"
                            HeightRequest="50"/>

                    <Button Text="Змінити емоцію"
                            Clicked="ShuffleButtonClicked"
                            BackgroundColor="{StaticResource OrangeColor}"
                            TextColor="{StaticResource DarkColor}"
                            CornerRadius="24"
                            HeightRequest="48"/>
                </VerticalStackLayout>
            </Frame>

            <Button x:Name="btnStop"
                    Text="Зупинити будильник"
                    Clicked="StopButtonClicked"
                    IsEnabled="False"
                    BackgroundColor="{StaticResource OrangeColor}"
                    TextColor="{StaticResource DarkColor}"
                    CornerRadius="30"
                    HeightRequest="60"
                    WidthRequest="220"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>