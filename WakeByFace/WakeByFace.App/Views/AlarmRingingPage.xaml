<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WakeByFace.App.Views.AlarmRingingPage"
             Title="AlarmRingingPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#7b9b9c">
    <ContentPage.Resources>
        <Color x:Key="MainBackgroundColor">#7B9B9C</Color>
        <Color x:Key="SectionsColor">#a6b0b1</Color>
        <Color x:Key="OrangeColor">#e69a67</Color>
        <Color x:Key="DarkColor">#383e3f</Color>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".2*"/>
            <RowDefinition Height=".6*"/>
            <RowDefinition Height=".2*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Frame Grid.Row="0" 
               BackgroundColor="{StaticResource SectionsColor}"
               BorderColor="Transparent"
               HasShadow="False"
               CornerRadius="0"
               Padding="0">
            <Grid BackgroundColor="{StaticResource MainBackgroundColor}">
                <Label Text="Будильник"
                       TextColor="{StaticResource OrangeColor}"
                       FontAttributes="Bold"
                       FontSize="26"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
                <BoxView HeightRequest="2"
                         HorizontalOptions="FillAndExpand"
                         VerticalOptions="End"
                         BackgroundColor="{StaticResource DarkColor}"/>
            </Grid>
        </Frame>
        
        <!--Main section for name and time -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="20"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
            <Label Text="{Binding Name}"
                   TextColor="{StaticResource DarkColor}"
                   HorizontalTextAlignment="Center"
                   FontSize="20"/>
            <Label Text="{Binding TextFormatted}"
                   TextColor="{StaticResource DarkColor}"
                   HorizontalTextAlignment="Center"
                   FontSize="52"
                   FontAttributes="Bold"/>
            <!-- Кнопка Зупинити -->
            <Button Text="Зупинити"
                    Clicked="StopButtonClicked"
                    BackgroundColor="{StaticResource OrangeColor}"
                    TextColor="{StaticResource DarkColor}"
                    CornerRadius="30"
                    HeightRequest="60"
                    WidthRequest="200"
                    HorizontalOptions="Center"/>

            <!-- Тимчасова кнопка для тесту (можеш потім видалити)
            <Button Text="🎧 Тест відтворення"
                    Clicked="TestButtonClicked"
                    BackgroundColor="{StaticResource SectionsColor}"
                    TextColor="{StaticResource DarkColor}"
                    CornerRadius="30"
                    HeightRequest="50"
                    WidthRequest="200"
                    HorizontalOptions="Center"/> -->
        </VerticalStackLayout>
    </Grid>
</ContentPage>